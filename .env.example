# RideFix local development environment
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in your own TEST/SANDBOX values:
#   cp .env.example .env
# `.env` is git-ignored. Never commit real keys.
#
# SERVER ONLY means the value must never be put in a mobile or web app.
# CLIENT SAFE means it is designed to be public (it ships inside the app).
# ------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# ---------- Self-hosted authentication ----------
# Auth service is not present in this repository yet. Add its settings when implemented.

# ---------- Kong API Gateway ----------
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# ---------- Shared PostgreSQL ----------
POSTGRES_USER=ridefix
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
POSTGRES_DB=ridefix_db

# All services use the same shared database in local development
REQUEST_DB_URL=postgres://ridefix:change-this-local-password@localhost:5432/ridefix_db
MATCHING_DB_URL=postgres://ridefix:change-this-local-password@localhost:5432/ridefix_db
BIDDING_DB_URL=postgres://ridefix:change-this-local-password@localhost:5432/ridefix_db
TRACKING_DB_URL=postgres://ridefix:change-this-local-password@localhost:5432/ridefix_db
PAYMENT_DB_URL=postgres://ridefix:change-this-local-password@localhost:5432/ridefix_db
NOTIFICATION_DB_URL=postgres://ridefix:change-this-local-password@localhost:5432/ridefix_db
AUTH_DB_URL=postgres://ridefix:change-this-local-password@localhost:5432/ridefix_db


# ---------- Service ports (inside Docker or on your laptop) ----------
REQUEST_SERVICE_PORT=4001
MATCHING_SERVICE_PORT=4002
BIDDING_SERVICE_PORT=4003
TRACKING_SERVICE_PORT=4004
PAYMENT_SERVICE_PORT=4005
NOTIFICATION_SERVICE_PORT=4006

# Internal service-to-service base URLs (direct HTTP, not through Kong)
REQUEST_SERVICE_URL=http://localhost:4001
MATCHING_SERVICE_URL=http://localhost:4002
BIDDING_SERVICE_URL=http://localhost:4003
TRACKING_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4006

# ---------- OpenStreetMap + OSRM ----------
# OSM tiles: show visible OpenStreetMap attribution in the app. Follow the tile usage policy.
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Free public OSRM demo for local development only. For production, run your own OSRM instance.
OSRM_BASE_URL=https://router.project-osrm.org

# ---------- ePay (sandbox) ----------
# Set EPAY_ACTION_URL to the sandbox URL while developing; use the live URL only after approval.
EPAY_ACTION_URL=https://sandbox-ipg.epay.lk/
EPAY_MERCHANT_ID=replace-with-sandbox-merchant-id
# SERVER ONLY. ePay App Secret signs checkout forms and verifies payment notifications.
EPAY_APP_SECRET=replace-with-sandbox-app-secret
# SERVER ONLY. Used by trusted backend callers to request a checkout; never put in mobile/web apps.
PAYMENT_INTERNAL_API_KEY=replace-with-a-long-random-local-secret
# ePay needs a public HTTPS callback; use a tunnel for local development.
EPAY_NOTIFY_URL=https://your-tunnel.example.com/payments/epay/notify
EPAY_RETURN_URL=ridefix://payment/return
EPAY_CANCEL_URL=ridefix://payment/cancel
PAYMENT_CURRENCY=LKR

# ---------- Firebase Cloud Messaging ----------
# SERVER ONLY. Path to the Firebase service account JSON (git-ignored), used by the Notification Service.
FCM_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# `mock` logs push messages instead of sending them.
PUSH_PROVIDER=mock

# ---------- Optional infrastructure (docker compose --profile optional) ----------
REDIS_URL=redis://localhost:6379
RABBITMQ_USER=ridefix
RABBITMQ_PASSWORD=change-me-locally
RABBITMQ_URL=amqp://ridefix:change-me-locally@localhost:5672
# Leave empty to use direct HTTP calls instead of RabbitMQ events.
EVENT_BUS=
