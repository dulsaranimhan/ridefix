# RideFix local development environment
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in your own TEST/SANDBOX values:
#   cp .env.example .env
# `.env` is git-ignored. Never commit real keys.
#
# SERVER ONLY means the value must never be put in a mobile or web app.
# CLIENT SAFE means it is designed to be public (it ships inside the app).
# ------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# ---------- Supabase Auth ----------
# Project URL and anon key: CLIENT SAFE (the apps use them to sign in).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
# SERVER ONLY. Full admin access to your Supabase project. Only for server-side admin tasks.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# How Kong verifies Supabase tokens. Check Supabase dashboard > Project Settings > JWT Keys.
#   HS256 (legacy shared secret) -> fill SUPABASE_JWT_SECRET (SERVER ONLY)
#   ES256/RS256 (signing keys)   -> fill SUPABASE_JWT_PUBLIC_KEY_PEM from the project's JWKS
SUPABASE_JWT_ALG=ES256
SUPABASE_JWT_SECRET=
SUPABASE_JWT_PUBLIC_KEY_PEM=
# Value of the `iss` claim in Supabase tokens.
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# ---------- Kong API Gateway ----------
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# ---------- PostgreSQL (one database + one login per service) ----------
POSTGRES_USER=ridefix
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
# Password for the six per-service logins (request_svc, matching_svc, ...). Local dev only.
SERVICE_DB_PASSWORD=change-me-locally
# Used when you run a service on your laptop with `pnpm dev` instead of Docker.
REQUEST_DB_URL=postgres://request_svc:change-me-locally@localhost:5432/request_db
MATCHING_DB_URL=postgres://matching_svc:change-me-locally@localhost:5432/matching_db
BIDDING_DB_URL=postgres://bidding_svc:change-me-locally@localhost:5432/bidding_db
TRACKING_DB_URL=postgres://tracking_svc:change-me-locally@localhost:5432/tracking_db
PAYMENT_DB_URL=postgres://payment_svc:change-me-locally@localhost:5432/payment_db
NOTIFICATION_DB_URL=postgres://notification_svc:change-me-locally@localhost:5432/notification_db

# ---------- Service ports (inside Docker or on your laptop) ----------
REQUEST_SERVICE_PORT=4001
MATCHING_SERVICE_PORT=4002
BIDDING_SERVICE_PORT=4003
TRACKING_SERVICE_PORT=4004
PAYMENT_SERVICE_PORT=4005
NOTIFICATION_SERVICE_PORT=4006

# Internal service-to-service base URLs (direct HTTP, not through Kong)
REQUEST_SERVICE_URL=http://localhost:4001
MATCHING_SERVICE_URL=http://localhost:4002
BIDDING_SERVICE_URL=http://localhost:4003
TRACKING_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4006

# ---------- Google Maps Platform ----------
# SERVER ONLY key for the Matching Service (Distance Matrix / Routes API). Restrict it by API.
GOOGLE_MAPS_SERVER_API_KEY=replace-with-server-key
# CLIENT SAFE key for map display in the apps. Restrict it by app bundle ID / web referrer.
GOOGLE_MAPS_CLIENT_API_KEY=replace-with-restricted-client-key
# `mock` returns fake distance/ETA so you can work without a key or billing.
MAPS_PROVIDER=mock

# ---------- PayHere (sandbox) ----------
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=replace-with-sandbox-merchant-id
# SERVER ONLY. Used to sign checkout requests and verify PayHere's server notification (md5sig).
PAYHERE_MERCHANT_SECRET=replace-with-sandbox-merchant-secret
# Public URL PayHere calls after a payment (use a tunnel such as ngrok for local testing).
PAYHERE_NOTIFY_URL=https://your-tunnel.example.com/payments/payhere/notify
PAYHERE_RETURN_URL=ridefix://payment/return
PAYHERE_CANCEL_URL=ridefix://payment/cancel
PAYMENT_CURRENCY=LKR

# ---------- Firebase Cloud Messaging ----------
# SERVER ONLY. Path to the Firebase service account JSON (git-ignored), used by the Notification Service.
FCM_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# `mock` logs push messages instead of sending them.
PUSH_PROVIDER=mock

# ---------- Optional infrastructure (docker compose --profile optional) ----------
REDIS_URL=redis://localhost:6379
RABBITMQ_USER=ridefix
RABBITMQ_PASSWORD=change-me-locally
RABBITMQ_URL=amqp://ridefix:change-me-locally@localhost:5672
# Leave empty to use direct HTTP calls instead of RabbitMQ events.
EVENT_BUS=
