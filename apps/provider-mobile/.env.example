# Copy to .env (git-ignored). EXPO_PUBLIC_ values are bundled INTO the app,
# so only put client-safe values here. Never a service-role key or payment secret.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# Kong proxy, the only API address. Use localhost for web on the same computer, 10.0.2.2 on an
# Android emulator, or the backend computer's LAN IP (http://192.168.1.20:8000) on a phone.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
