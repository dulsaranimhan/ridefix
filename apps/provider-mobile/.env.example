# Copy to .env (git-ignored). EXPO_PUBLIC_ values are bundled INTO the app,
# so only put client-safe values here. Never a service-role key or payment secret.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Kong proxy. On an Android emulator use http://10.0.2.2:8000, on a phone use your laptop's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_GOOGLE_MAPS_CLIENT_API_KEY=replace-with-restricted-client-key
