# Copy to .env (git-ignored). VITE_ values are bundled into the browser app,
# so only client-safe values go here. Admin actions that need the Supabase
# service-role key must happen on a server, never in this app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
VITE_API_BASE_URL=http://localhost:8000
