# Copy to .env (git-ignored). EXPO_PUBLIC_ values are bundled into the app,
# so only put public values here. Never add a payment secret or database password.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# Kong proxy. On an Android emulator use http://10.0.2.2:8000, on a phone use your laptop's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
