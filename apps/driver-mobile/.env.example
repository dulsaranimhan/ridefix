# Copy to .env (git-ignored). EXPO_PUBLIC_ values are bundled into the app,
# so only put public values here. Never add a Supabase service-role/secret key, a payment secret,
# or a database password.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# Kong proxy. Use localhost for web on the same computer, 10.0.2.2 on an Android emulator, or the
# backend computer's LAN IP (for example http://192.168.1.20:8000) on a phone. Restart Expo after changing it.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
