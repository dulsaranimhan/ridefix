{
  "name": "auth-service",
  "version": "0.0.0",
  "private": true,
  "description": "Owns user accounts, password login and RideFix JWTs",
  "files": [
    "dist",
    "migrations"
  ],
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "seed:admin": "tsx --env-file-if-exists=../../.env src/seed-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@ridefix/service-kit": "workspace:*",
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@ridefix/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
